# Copy to .env for local / Docker Compose (never commit .env).
# Docker: cp .env.example .env && docker compose up --build

ALIVE_PERSONA=minase
ALIVE_HOME=

# Voice call page (Docker Compose sets ALIVE_VOICE_HOST=0.0.0.0)
ALIVE_VOICE_PORT=8766
# ALIVE_VOICE_HOST=127.0.0.1

# Required only for scripted heartbeats (alive tick / alive start).
# In-character chat uses the host Code Agent model.
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# Optional platform unlocks
AIHUBMIX_API_KEY=
FAL_KEY=
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
IMGURL_TOKEN=
XHS_SKILLS_DIR=

# LiveKit / STT / TTS (see USAGE.md and alive/voice/.env.example)
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# CARTESIA_API_KEY=
# VOXCPM_URL=

# talk-to-fengge join page for proactive voice calls (heartbeat voice-call)
TALK_TO_FENGGE_URL=http://127.0.0.1:8766
