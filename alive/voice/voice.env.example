# Alive 语音栈配置模板：cp alive/voice/voice.env.example alive/voice/voice.env 后按需改。
# start-all.sh 会 source 本目录的 voice.env（再叠加 $ALIVE_HOME/.env），两个都不入库。
# 端口注意：8000 可能被 xiaozhi 之类占用，VoxCPM 侧车默认走 8801。

# --- VoxCPM2 TTS 侧车 ---
VOXCPM_HOST=127.0.0.1
VOXCPM_PORT=8801
# 本地权重目录（hf download openbmb/VoxCPM2 --local-dir <这里>），约 4.6GiB
VOXCPM_MODEL=/path/to/models/VoxCPM2
VOXCPM_CUDA=1
VOXCPM_URL=http://127.0.0.1:8801
VOXCPM_VOICE=default

# --- LiveKit ---
# localhost 单机跑必须钉 node-ip：自动探测会广播一个客户端不可达的地址，ICE 会超时
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_BIND=127.0.0.1
LIVEKIT_NODE_IP=127.0.0.1
# livekit-server --dev 的默认开发账密
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WORKER_PORT=8081

# --- LLM（OpenAI 兼容；LM Studio / vLLM / OpenAI 都行）---
LLM_API_BASE=http://127.0.0.1:1234/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=lm-studio

# --- STT（OpenAI 兼容；speaches / faster-whisper 服务）---
STT_PROVIDER=openai
OPENAI_STT_BASE=http://127.0.0.1:8000/v1
# livekit-plugins-openai 默认请求 gpt-4o-mini-transcribe；自建 whisper 服务要显式覆盖
OPENAI_STT_MODEL=whisper-1
STT_LANGUAGE=zh

# --- 人格 / 选择 ---
TTS_PROVIDER=voxcpm
AGENT_NAME=alive-voice
ALIVE_PERSONA=minase
ALIVE_VOICE_URL=http://127.0.0.1:8766
