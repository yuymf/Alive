# 复制需要的行到 $ALIVE_HOME/.env（默认 ~/.alive/.env）
# 手把手说明见仓库根目录 USAGE.md

ALIVE_PERSONA=minase
ALIVE_VOICE_PORT=8766
AGENT_NAME=alive-voice

# 文字心跳 / 电话 LLM（电话 Agent 也读这三项）
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# LiveKit。本机开发用 --dev 默认账密：
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# STT。推荐 Cartesia；没有就用 openai（复用 LLM_API_KEY）
STT_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_STT_LANGUAGE=zh

# VoxCPM
TTS_PROVIDER=voxcpm
VOXCPM_URL=http://127.0.0.1:8000
VOXCPM_VOICE=default
