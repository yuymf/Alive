{
  "name": "@yuymf/alive",
  "version": "0.9.0",
  "description": "Alive — distill a person, adopt the skill, give it a life beyond chat.",
  "publishConfig": {
    "access": "public"
  },
  "main": "bin/cli.js",
  "bin": {
    "alive": "bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuymf/Alive.git"
  },
  "homepage": "https://github.com/yuymf/Alive#readme",
  "bugs": {
    "url": "https://github.com/yuymf/Alive/issues"
  },
  "author": "yuymf",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "bin",
    "alive",
    "dist-alive",
    "examples",
    "USAGE.md",
    "INSTALL.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "digital-life",
    "alive",
    "ai-persona",
    "ai-companion",
    "autonomous-agent",
    "persona-skill",
    "nuwa",
    "social-media"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "jimp": "^1.6.0",
    "livekit-server-sdk": "^2.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
